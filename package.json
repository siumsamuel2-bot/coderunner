{
    "version": "0.1.0",
    "name": "coderunner",
    "scripts": {
        "start": "node scripts/start.mjs",
        "lint": "eslint",
        "test": "vitest run",
        "db:seed": "prisma db seed",
        "db:push": "prisma db push",
        "build": "prisma generate && next build --webpack",
        "db:check": "tsx scripts/db-check.ts",
        "verification-worker": "tsx scripts/verification-worker.ts",
        "dev": "next dev",
        "cf:build": "opennextjs-cloudflare build",
        "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types",
    "deploy:prod": "node scripts/deploy.mjs",
    "postinstall": "node scripts/patch-otel-api.mjs"
  },
    "devDependencies": {
        "@opennextjs/cloudflare": "^1.20.12",
        "@opentelemetry/api": "^1.9.1",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "^16.4.2",
        "patch-package": "^8.0.1",
        "prisma": "^7.10.0",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "wrangler": "^4.151.1"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1152.0",
        "@aws-sdk/s3-request-presigner": "^3.1152.0",
        "@clerk/nextjs": "^6.36.6",
        "@coderunner/verification-harness": "file:./verification",
        "@neondatabase/serverless": "^0.9.0",
        "@prisma/adapter-neon": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "@sentry/nextjs": "^11.6.0",
        "@trpc/server": "^11.19.0",
        "dotenv": "^18.0.4",
        "next": "^16.4.2",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "resend": "^4.8.0",
        "svix": "^1.81.0",
        "zod": "^4.6.5"
    },
