# Local development (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Production (Neon PostgreSQL - serverless with connection pooling)
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# --- Auth (Clerk) ---
# Get from Clerk Dashboard > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Webhook secret from Clerk Dashboard > Webhooks
CLERK_WEBHOOK_SECRET="whsec_xxx"
# Clerk URLs (customize if using custom domains)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/challenges"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/challenges"

# --- Email (Resend) ---
# Get from Resend Dashboard > API Keys
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="noreply@coderunner.dev"

# --- Storage (Cloudflare R2) ---
# Get from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID="xxx"
R2_ACCESS_KEY_ID="xxx"
R2_SECRET_ACCESS_KEY="xxx"
R2_BUCKET="coderunner-verification"
# Optional: Public URL for R2 bucket (if using custom domain or public bucket)
# R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# --- Verification Webhook ---
# Secret for verifying webhook calls (generate a strong random string)
VERIFICATION_WEBHOOK_SECRET="xxx"

# --- App ---
NEXT_PUBLIC_APP_URL="https://coderunner.dev"
NODE_ENV="production"

# --- Observability (SPE-99) — all optional; monitoring is disabled without these ---
# Sentry error tracking + APM (free tier).
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
# SENTRY_ENVIRONMENT="production"
# Build-time only: enable source-map upload (+ init Sentry in next.config).
# SENTRY_ORG="your-org" SENTRY_PROJECT="coderunner" SENTRY_AUTH_TOKEN="sntrys_..."

# --- Cloudflare Pages ---
# Set automatically by Cloudflare Pages during build
# CLOUDFLARE_PAGES=1

