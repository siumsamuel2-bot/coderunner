# Local development (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Production (Railway PostgreSQL plugin injects DATABASE_URL automatically — see SPE-46/SPE-47)
# DATABASE_URL="postgresql://postgres:password@host:5432/railway"

# Auth.js v5 — generate with: openssl rand -base64 32 (or node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=""

# Public app URL (Railway URL or custom domain in production)
# AUTH_URL="http://localhost:3000"

# OAuth providers (set in Railway vars or provider dashboards)
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
