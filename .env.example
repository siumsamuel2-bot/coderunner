# Local development
DATABASE_URL="postgresql://user:password@localhost:5432/coderunner?sslmode=require"

# --- Clerk auth (SPE-123: replaces NextAuth) ---
# Publishable key is inlined into client bundles at build time.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Svix signing secret for the user-sync webhook (Clerk dashboard -> Webhooks)
CLERK_WEBHOOK_SECRET="whsec_..."

# --- Admin access (SPE-118) - comma-separated allowlist of admin emails ---
# Without this, no one can access the admin panel (secure default).
# ADMIN_EMAILS="sam@coderunner.dev,ops@coderunner.dev"

# --- Email: Resend (SPE-123) ---
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="onboarding@resend.dev"

# --- Storage: Cloudflare R2, S3-compatible API (SPE-123) ---
R2_ACCOUNT_ID="<32-hex cloudflare account id>"
R2_ACCESS_KEY_ID="<r2 api token access key>"
R2_SECRET_ACCESS_KEY="<r2 api token secret>"
R2_BUCKET="coderunner-evidence"

# --- Verification webhook auth (SPE-120) ---
# Shared secret between the external verification worker and POST /api/verification-webhook.
# VERIFICATION_WEBHOOK_SECRET="..."

# --- Cron auth (SPE-100/SPE-120) ---
# Shared secret for /api/cron/* endpoints (sweeper, verify stats).
# CRON_SECRET="..."

# --- Observability (SPE-99, optional) ---
# Sentry error tracking; disabled without NEXT_PUBLIC_SENTRY_DSN.
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
