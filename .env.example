# Local development (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Production (Railway PostgreSQL plugin injects DATABASE_URL automatically — see SPE-46/SPE-47)
# DATABASE_URL="postgresql://postgres:password@host:5432/railway"

# --- Observability (SPE-99) — all optional; monitoring is disabled without these ---
# Sentry error tracking + APM (free tier). Rail­way injects RAILWAY_GIT_COMMIT_SHA
# automatically for release tagging.
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
# SENTRY_ENVIRONMENT="production"
# Build-time only: enable source-map upload (+ init Sentry in next.config).
# SENTRY_ORG="your-org" SENTRY_PROJECT="coderunner" SENTRY_AUTH_TOKEN="sntrys_..."

