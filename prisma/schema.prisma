generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // workerd: emits a static .wasm import (wasm-worker-loader) instead of
  // base64-decoding + new WebAssembly.Module(), which Cloudflare Workers
  // rejects ("Wasm code generation disallowed by embedder").
  runtime = "workerd"
}

// Second generation for Node hosts (seed, db-check, verification worker on
// GitHub Actions): the workerd runtime's `?module` wasm import does not
// resolve under plain Node/tsx, so Node consumers import this client instead.
generator clientNode {
  provider = "prisma-client"
  output   = "../src/generated/prisma-node"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  clerkId       String?   @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  runs          Run[]
}

model Challenge {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  description        String
  difficulty         String
  language           String   @default("typescript")
  // SPE-131/SPE-126: listing metadata. category is a free-form short label
  // (algorithms, frontend, backend, full-stack, ai, data, general); the UI
  // reads distinct values from the DB. aiAllowed=true means AI coding
  // assistants are permitted during the run (true for all challenges today).
  // NOTE: no timeLimitMinutes yet — nothing enforces a hard cutoff, so the
  // UI must present estimatedMinutes as an estimate, never a limit.
  category           String   @default("general")
  aiAllowed          Boolean  @default(true)
  estimatedMinutes   Int
  testSpec           Json
  acceptanceCriteria String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  runs               Run[]
  verificationJobs   VerificationJob[]
}

model Run {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  status      String    @default("in_progress")
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  elapsedMs   Int?
  attempt     Int       @default(1)
  promptChain Json?
  toolLog     Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  verification Verification?
  verificationJobs VerificationJob[]
}

model Verification {
  id         String   @id @default(cuid())
  runId      String   @unique
  status     String
  testOutput String?
  reportData Json?
  verifiedAt DateTime @default(now())
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(cuid())
  category  String   @default("general")
  message   String
  email     String?
  page      String?
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model VerificationJob {
  id          String   @id @default(cuid())
  runId       String   @unique
  challengeId String
  targetUrl   String
  status      String   @default("pending")
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}
